.wrap { padding: 140rpx 40rpx 60rpx; min-height: 100vh; }

.brand { display: flex; align-items: center; gap: 20rpx; margin-bottom: 40rpx; }
.logo {
  width: 84rpx; height: 84rpx; border-radius: 22rpx;
  background: rgba(45, 212, 191, 0.18); color: #7fe8d8;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 700;
}
.brand-name { font-size: 34rpx; font-weight: 700; color: #eafffb; }
.brand-sub { font-size: 20rpx; color: #6f9c9e; letter-spacing: 2rpx; }

.clock { font-size: 64rpx; font-weight: 700; color: #eafffb; }
.date { font-size: 24rpx; color: #8fb3b5; margin-bottom: 36rpx; }

.welcome { font-size: 36rpx; font-weight: 700; color: #eafffb; margin-bottom: 8rpx; }

.demo { margin-top: 32rpx; border-top: 1rpx solid rgba(255,255,255,0.08); padding-top: 24rpx; }
.demo-list { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.demo-item {
  width: calc(50% - 8rpx); box-sizing: border-box;
  background: rgba(255,255,255,0.05); border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 16rpx; padding: 16rpx 18rpx;
}
.demo-role { display: block; font-size: 26rpx; color: #dcfff8; margin-bottom: 4rpx; }

.foot { text-align: center; margin-top: 48rpx; color: #6f9c9e; }

.alert-warn {
  background: rgba(251, 191, 36, 0.16);
  border: 1rpx solid rgba(251, 191, 36, 0.32);
  color: #ffe8b0;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 22rpx;
  margin-bottom: 18rpx;
  line-height: 1.5;
}
.net-test {
  margin-top: 18rpx; text-align: center; font-size: 24rpx;
  color: #7fe8d8; text-decoration: underline;
}

.server-switch {
  margin-top: 10rpx; text-align: center; font-size: 22rpx; color: #8fb3b5;
}
