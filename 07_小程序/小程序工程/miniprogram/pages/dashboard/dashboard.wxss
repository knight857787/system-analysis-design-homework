.logout {
  padding: 10rpx 24rpx; border-radius: 999rpx;
  border: 1rpx solid rgba(255,255,255,0.16); color: #b9d9d6; font-size: 24rpx;
}
.todo { display: flex; align-items: center; gap: 14rpx; padding: 12rpx 0; }
.todo-text { color: #dcfff8; font-size: 26rpx; }
.grid { display: flex; flex-wrap: wrap; gap: 18rpx; }
.entry {
  width: calc(33.33% - 12rpx); box-sizing: border-box;
  background: rgba(255,255,255,0.05); border-radius: 18rpx;
  padding: 24rpx 0; text-align: center;
}
.entry-icon { font-size: 34rpx; color: #7fe8d8; }
.entry-label { font-size: 24rpx; color: #dcfff8; margin-top: 8rpx; }
