<view class="page">
  <view class="row" style="margin-bottom: 24rpx;">
    <view>
      <view style="font-size: 36rpx; font-weight: 700; color: #eafffb;">{{greeting}}</view>
      <view class="muted">{{user.name}} · {{user.roleLabel}}<text wx:if="{{scope}}"> · {{scope}}</text></view>
    </view>
    <view class="spacer"></view>
    <view class="logout" bindtap="logout">退出</view>
  </view>

  <view wx:if="{{loading}}" class="card"><view class="muted">加载中…</view></view>

  <block wx:else>
    <!-- 老板 / 销售：今日经营 -->
    <view class="card" wx:if="{{isOwner || isSales}}">
      <view class="card-title">今日经营</view>
      <view class="kpi-row">
        <view class="kpi">
          <view class="kpi-label">销售额</view>
          <view class="kpi-value">{{today.amountText}}</view>
          <view class="kpi-sub">{{today.orders}} 单</view>
        </view>
        <view class="kpi" wx:if="{{isOwner}}">
          <view class="kpi-label">毛利</view>
          <view class="kpi-value">{{today.profitText}}</view>
          <view class="kpi-sub">毛利率 {{today.marginText}}</view>
        </view>
        <view class="kpi" wx:else>
          <view class="kpi-label">客单价</view>
          <view class="kpi-value">{{today.avgText}}</view>
          <view class="kpi-sub">元 / 单</view>
        </view>
      </view>
      <view class="kpi-row" style="margin-top: 20rpx;" wx:if="{{isOwner}}">
        <view class="kpi">
          <view class="kpi-label">客单价</view>
          <view class="kpi-value">{{today.avgText}}</view>
          <view class="kpi-sub">元 / 单</view>
        </view>
        <view class="kpi">
          <view class="kpi-label">本月销售</view>
          <view class="kpi-value">{{month.amountText}}</view>
          <view class="kpi-sub">毛利 {{month.profitText}}</view>
        </view>
      </view>
    </view>

    <!-- 销售：赊账与线上 -->
    <view class="card" wx:if="{{isSales}}">
      <view class="card-title">赊账与线上</view>
      <view class="kpi-row">
        <view class="kpi">
          <view class="kpi-label">赊账余额</view>
          <view class="kpi-value">{{credit.outstandingText}}</view>
          <view class="kpi-sub">逾期 {{credit.overdue}} 户</view>
        </view>
        <view class="kpi">
          <view class="kpi-label">线上待拣货</view>
          <view class="kpi-value">{{online.pendingPick}}</view>
          <view class="kpi-sub">今日 {{online.todayOrders}} 单</view>
        </view>
      </view>
    </view>

    <!-- 供货商：订货与对账 -->
    <view class="card" wx:if="{{isSupplier}}">
      <view class="card-title">订货与对账</view>
      <view class="kpi-row">
        <view class="kpi">
          <view class="kpi-label">在途订货单</view>
          <view class="kpi-value">{{supplier.pendingOrders}}</view>
          <view class="kpi-sub">待确认或待发货</view>
        </view>
        <view class="kpi">
          <view class="kpi-label">待核对对账单</view>
          <view class="kpi-value">{{supplier.pendingStatements}}</view>
          <view class="kpi-sub">含差异待答复</view>
        </view>
      </view>
    </view>

    <!-- 库存概览：老板 / 理货员 / 销售 -->
    <view class="card" wx:if="{{!isSupplier}}">
      <view class="card-title">库存概览</view>
      <view class="kpi-row">
        <view class="kpi">
          <view class="kpi-label">在架商品</view>
          <view class="kpi-value">{{stock.skuCount}}</view>
          <view class="kpi-sub">{{stock.batches}} 个批次</view>
        </view>
        <view class="kpi" wx:if="{{isOwner}}">
          <view class="kpi-label">库存金额</view>
          <view class="kpi-value">{{stock.valueText}}</view>
          <view class="kpi-sub">现存 {{stock.qtyText}}</view>
        </view>
        <view class="kpi" wx:else>
          <view class="kpi-label">库存数量</view>
          <view class="kpi-value">{{stock.qtyText}}</view>
          <view class="kpi-sub">按批次</view>
        </view>
        <view class="kpi">
          <view class="kpi-label">临期/过期</view>
          <view class="kpi-value">{{expiry.count}}</view>
          <view class="kpi-sub">临期 {{expiry.expiring}}</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">待办</view>
      <view wx:if="{{todos.length === 0}}" class="muted">暂无待办</view>
      <view wx:for="{{todos}}" wx:key="key" class="todo" data-key="{{item.key}}" bindtap="goTodo">
        <text class="tag">{{item.count}}</text>
        <text class="todo-text">{{item.title}}</text>
      </view>
    </view>

    <view class="card">
      <view class="card-title">快捷入口</view>
      <view class="grid">
        <view wx:for="{{entries}}" wx:key="key" class="entry" data-key="{{item.key}}" bindtap="go">
          <view class="entry-icon">{{item.icon}}</view>
          <view class="entry-label">{{item.label}}</view>
        </view>
      </view>
      <view class="tiny" style="margin-top: 16rpx;">按角色展示可办理的入口</view>
    </view>
  </block>
</view>
