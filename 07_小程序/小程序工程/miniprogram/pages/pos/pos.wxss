.search-row { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.search { flex: 1; }
.scan-btn {
  width: 140rpx; text-align: center; padding: 22rpx 0; border-radius: 16rpx;
  background: rgba(45,212,191,0.16); color: #7fe8d8; font-size: 28rpx;
}
.item, .cart-row {
  display: flex; align-items: center; gap: 16rpx;
  padding: 18rpx 0; border-bottom: 1rpx solid rgba(255,255,255,0.06);
}
.item:last-child, .cart-row:last-child { border-bottom: 0; }
.item-main { flex: 1; min-width: 0; }
.item-name { font-size: 28rpx; color: #eafffb; }
.item-right { text-align: right; }
.price { font-size: 28rpx; color: #7fe8d8; }
.add { font-size: 30rpx; color: #2dd4bf; text-align: right; }
.qty { display: flex; align-items: center; gap: 12rpx; }
.qty-btn {
  width: 52rpx; height: 52rpx; line-height: 48rpx; text-align: center;
  border-radius: 12rpx; background: rgba(255,255,255,0.08); color: #dcfff8; font-size: 30rpx;
}
.qty-num { min-width: 56rpx; text-align: center; font-size: 26rpx; }
.amount { width: 140rpx; text-align: right; color: #eafffb; }
.discount { width: 180rpx; text-align: right; }
.total-row { margin-top: 20rpx; }
.total { font-size: 40rpx; font-weight: 700; color: #2dd4bf; }

.release-note {
  margin-top: 24rpx; padding: 18rpx 20rpx; border-radius: 14rpx;
  background: rgba(251, 191, 36, 0.14);
  border: 1rpx solid rgba(251, 191, 36, 0.3);
  color: #ffe8b0; font-size: 22rpx; line-height: 1.6;
}
