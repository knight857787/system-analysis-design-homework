<view class="page">
  <view class="card"><view class="muted">{{items.length}} 张线上订单</view></view>
  <view wx:if="{{loading}}" class="card"><view class="muted">加载中…</view></view>
  <view wx:for="{{items}}" wx:key="OrderID" class="card row-card">
    <view class="row">
      <view class="name">{{item.OrderNo}}</view>
      <view class="spacer"></view>
      <view class="amount">¥{{item.amountText}}</view>
    </view>
    <view class="tiny" style="margin-top:6rpx;">{{item.CustomerName}} · {{item.channelText}} · {{item.FulfilMethod}}</view>
    <view class="row" style="margin-top:8rpx;">
      <view class="tiny">下单 {{item.PlacedAt}}</view>
      <view class="spacer"></view>
      <view class="tag">{{item.statusText}}</view>
    </view>
  </view>
  <view wx:if="{{!loading && items.length === 0}}" class="card"><view class="muted">暂无线上订单</view></view>
</view>
