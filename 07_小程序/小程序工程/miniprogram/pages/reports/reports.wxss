.bar-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 14rpx; }
.bar-label { width: 140rpx; font-size: 24rpx; color: #cddfdd; }
.bar-track { flex: 1; height: 16rpx; background: rgba(255,255,255,0.07); border-radius: 999rpx; overflow: hidden; }
.bar-fill { height: 100%; background: #2dd4bf; }
.bar-value { width: 150rpx; text-align: right; font-size: 22rpx; color: #8fb3b5; }
.top-row { display: flex; align-items: center; padding: 8rpx 0; }
.top-name { font-size: 26rpx; color: #eafffb; }
