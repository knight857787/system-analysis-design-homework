.wrap { min-height: 100vh; padding: 48rpx 36rpx; box-sizing: border-box; background: #0f2e2c; }
.brand { display: flex; align-items: center; gap: 20rpx; margin-bottom: 40rpx; }
.logo { width: 76rpx; height: 76rpx; border-radius: 20rpx; background: #143733; color: #7fe8d8;
  display: flex; align-items: center; justify-content: center; font-size: 40rpx; }
.brand-name { color: #eafffb; font-size: 34rpx; font-weight: 700; }
.brand-sub { color: #6f8e88; font-size: 20rpx; letter-spacing: 2rpx; }
.card { background: #143733; border-radius: 24rpx; padding: 36rpx 30rpx; }
.welcome { color: #eafffb; font-size: 34rpx; font-weight: 700; margin-bottom: 8rpx; }
.muted { color: #9fbdba; font-size: 24rpx; line-height: 1.6; margin-bottom: 24rpx; }
.field { margin-bottom: 22rpx; }
.field-label { color: #9fbdba; font-size: 24rpx; margin-bottom: 10rpx; }
.input { background: #0f2e2c; border: 1rpx solid #24524c; border-radius: 14rpx;
  color: #eafffb; font-size: 28rpx; padding: 22rpx 20rpx; }
.btn-primary { margin-top: 18rpx; background: #7fe8d8; color: #06302b; font-size: 30rpx; font-weight: 700;
  text-align: center; padding: 26rpx 0; border-radius: 16rpx; }
.btn-primary.disabled { opacity: 0.6; }
.net-test { margin-top: 20rpx; text-align: center; color: #9fbdba; font-size: 24rpx; }
.alert-danger { background: #3a1d1d; color: #ffb4b4; border-radius: 12rpx; padding: 16rpx 20rpx;
  font-size: 24rpx; margin-bottom: 20rpx; }
