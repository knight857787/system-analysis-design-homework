<view class="page">
  <view class="card">
    <view class="muted">订货单（{{items.length}} 张）· 合计 ¥{{totalAmount}}</view>
    <view class="tiny" style="margin-top:6rpx;">补货建议与下单请在网页端确认；这里用于查看在途</view>
  </view>
  <view wx:if="{{loading}}" class="card"><view class="muted">加载中…</view></view>
  <view wx:for="{{items}}" wx:key="OrderID" class="card row-card">
    <view class="row">
      <view class="name">{{item.OrderNo}}</view>
      <view class="spacer"></view>
      <view class="amount">¥{{item.amountText}}</view>
    </view>
    <view class="tiny" style="margin-top:6rpx;">{{item.SupplierName}} · {{item.statusText}} · 预计到货 {{item.ExpectedArrivalDate || '—'}}</view>
  </view>
  <view wx:if="{{!loading && items.length === 0}}" class="card"><view class="muted">暂无订货单</view></view>
</view>
