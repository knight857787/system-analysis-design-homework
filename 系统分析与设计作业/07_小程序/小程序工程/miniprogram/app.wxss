/* 与网页端一致的深青主题 */
page {
  background: #0b1f1e;
  color: #e6f4f2;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.page { padding: 32rpx 28rpx 80rpx; }

.card {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-title { font-size: 30rpx; font-weight: 600; color: #eafffb; margin-bottom: 18rpx; }
.muted { color: #8fb3b5; font-size: 24rpx; }
.tiny { color: #6f9c9e; font-size: 22rpx; }
.mono { font-family: Menlo, Consolas, monospace; }

.kpi-row { display: flex; gap: 20rpx; }
.kpi { flex: 1; background: rgba(45, 212, 191, 0.08); border-radius: 18rpx; padding: 22rpx; }
.kpi-label { font-size: 22rpx; color: #8fb3b5; }
.kpi-value { font-size: 40rpx; font-weight: 700; color: #2dd4bf; margin-top: 8rpx; }
.kpi-sub { font-size: 22rpx; color: #6f9c9e; margin-top: 4rpx; }

.row { display: flex; align-items: center; }
.spacer { flex: 1; }

.btn-primary {
  background: #eafffb;
  color: #0b2b28;
  border-radius: 16rpx;
  font-weight: 600;
  font-size: 30rpx;
  padding: 24rpx 0;
  text-align: center;
  margin-top: 24rpx;
}
.btn-primary.disabled { opacity: 0.5; }

.field-label { font-size: 24rpx; color: #8fb3b5; margin-bottom: 10rpx; }
.input {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  color: #eafffb;
  font-size: 28rpx;
}
.field { margin-bottom: 24rpx; }

.alert-danger {
  background: rgba(190, 42, 42, 0.22);
  border: 1rpx solid rgba(248, 113, 113, 0.3);
  color: #ffd6d6;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: rgba(45, 212, 191, 0.14);
  color: #7fe8d8;
}
